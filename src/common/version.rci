/* Shared version resource. Define VX_DESC and VX_NAME before including. */
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,3,0,0
 PRODUCTVERSION 1,3,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "VistaExt project"
      VALUE "FileDescription", VX_DESC
      VALUE "FileVersion", "1.3.1"
      VALUE "InternalName", VX_NAME
      VALUE "OriginalFilename", VX_NAME ".exe"
      VALUE "ProductName", "VistaExt"
      VALUE "ProductVersion", "1.3.1 (Beta 1.3.1)"
      VALUE "LegalCopyright", "GPL-2.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
